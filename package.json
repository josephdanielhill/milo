{
  "name": "milo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:published": "node build/generate-published-resources.mjs",
    "generate:version": "node build/generate-version.mjs",
    "predev": "npm run generate:published && npm run generate:version",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run generate:published && npm run generate:version",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "prebuild:pages": "npm run generate:published && npm run generate:version",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run build:pages && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/markdown.test.mjs tests/storage.test.mjs",
    "prelint": "npm run generate:published",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern pages-dist --ignore-pattern .next"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
